{
  "version": 2,
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index.py?engineering_path=/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?engineering_path=/health"
    },
    {
      "source": "/login",
      "destination": "/api/index.py?engineering_path=/login"
    },
    {
      "source": "/app",
      "destination": "/api/index.py?engineering_path=/app"
    },
    {
      "source": "/",
      "destination": "/api/index.py?engineering_path=/app"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate"},
        {"key": "Pragma", "value": "no-cache"},
        {"key": "Expires", "value": "0"}
      ]
    }
  ],
  "regions": ["hnd1"],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}