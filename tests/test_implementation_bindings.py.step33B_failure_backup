import importlib
from pathlib import Path

from skill_framework.registry import load_registry
from skill_framework.implementation_bindings import binding_map


ROOT = Path(__file__).resolve().parents[1]


def test_every_executable_registry_skill_has_exactly_one_binding():
    registry = load_registry(ROOT / "skill_registry" / "registry.yaml")
    bindings = binding_map()

    assert len(bindings) == len(registry.executable_ids)
    assert set(bindings) == set(registry.executable_ids)


def test_pending_skill_has_no_binding():
    registry = load_registry(ROOT / "skill_registry" / "registry.yaml")
    bindings = binding_map()

    assert "chiller_efficiency" in registry.pending_ids
    assert "chiller_efficiency" not in bindings


def test_binding_modules_and_classes_exist():
    registry = load_registry(ROOT / "skill_registry" / "registry.yaml")

    for skill_id in registry.executable_ids:
        binding = binding_map()[skill_id]
        module = importlib.import_module(binding.implementation_path)
        implementation = getattr(module, binding.implementation_class)
        assert implementation is not None


def test_no_duplicate_skill_bindings():
    from skill_framework.implementation_bindings import IMPLEMENTATION_BINDINGS

    ids = [item.skill_id for item in IMPLEMENTATION_BINDINGS]
    assert len(ids) == len(set(ids))


def test_orchestrator_binding_inventory_matches_compatibility_layer():
    import ast

    source = (ROOT / "orchestrator" / "engine.py").read_text(encoding="utf-8")
    tree = ast.parse(source)

    imported_classes = set()

    for node in tree.body:
        if isinstance(node, ast.ImportFrom):
            for alias in node.names:
                imported_classes.add(alias.name)

    bindings = binding_map()
    compatibility_classes = {item.implementation_class for item in bindings.values()}

    assert compatibility_classes.issubset(imported_classes)

