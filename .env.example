# Deterministic default; use "openai" only when an API key is configured.
ENGINEERING_AI_INTENT_PROVIDER=rule_based

# Optional OpenAI provider
OPENAI_API_KEY=
ENGINEERING_AI_MODEL=gpt-5.6

# Production Supabase persistence/auth boundary
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Do not expose SUPABASE_SERVICE_ROLE_KEY to browsers.

# External integration trial
# Gmail: configure OAuth client credentials in the deployment secret store.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Upwork: only after an Upwork API key/application is approved.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=

# Gumroad OAuth/API
GUMROAD_CLIENT_ID=
GUMROAD_CLIENT_SECRET=
GUMROAD_REDIRECT_URI=

# Trial webhook secrets. Use a separate value per provider and replace this
# simple shared-secret mechanism with signed/provider-verified callbacks for production.
INTEGRATION_WEBHOOK_SECRET_GUMROAD=
INTEGRATION_WEBHOOK_SECRET_UPWORK=
INTEGRATION_WEBHOOK_SECRET_GMAIL=
INTEGRATION_WEBHOOK_SECRET_FIVERR=
# Local trial-only Gmail token storage. Production must use encrypted tenant-scoped storage.
GMAIL_TOKEN_DIR=.tokens/gmail
GMAIL_SYNC_QUERY=is:unread
